{
  "name": "loadgen",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.ts",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "ui:test": "npm --prefix ui test",
    "ui:typecheck": "npm --prefix ui run typecheck"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.0"
  }
}
