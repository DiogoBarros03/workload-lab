root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
insert_final_newline = true

[*.cs]
indent_size = 4
# The C# half of the complexity ceiling; the Node half lives in eslint.config.mjs.
dotnet_diagnostic.S1541.severity = error
dotnet_diagnostic.S1541.maximumFunctionComplexityThreshold = 10
